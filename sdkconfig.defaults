CONFIG_IDF_TARGET="esp32s3"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# PSRAM is physically present on the N16R8, but this first milestone does not
# require it. Disabling external-heap integration avoids an ESP-IDF 6 beta
# startup fault while CAN/BLE bring-up is being validated.
# CONFIG_SPIRAM is not set
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
